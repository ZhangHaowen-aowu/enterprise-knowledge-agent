# For --mode llm only: supply an API credential privately on your computer.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-with-your-private-api-key
OPENAI_MODEL=replace-with-an-available-model
# Set to 0 only if your OpenAI-compatible service does not support JSON response_format.
LLM_JSON_MODE=1
# Transient API failure handling (defaults shown).
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY_SECONDS=1
